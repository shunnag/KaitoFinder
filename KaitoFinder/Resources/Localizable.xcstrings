        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu konumda kesilen bir kaydetme kurtarma gerektirebilir. Kaydetme sırasında okuyan diğer uygulamalar eski ve yeni ciltlerin karışımını görebilir."
