    "フォルダはプレビューまたは外部アプリケーションで開けません": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダはプレビューまたは外部アプリケーションで開けません"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folders cannot be previewed or opened in another application."
          }
        }
      }
    },
    "暗号化された項目にはパスワードが必要です": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗号化された項目にはパスワードが必要です"
