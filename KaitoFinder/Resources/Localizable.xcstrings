    "分割アーカイブ（%lld個・各%@）。保存すると同じ巻サイズで分割し直します。" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozdělený archiv (%lld svazků po %@). Při ukládání se znovu rozdělí se stejnou velikostí svazku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opdelt komprimeret arkiv (%lld volumener på %@). Ved arkivering opdeles det igen med samme volumenstørrelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geteiltes Archiv (%lld Volumes mit je %@). Beim Sichern wird es erneut mit derselben Volumegröße geteilt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Split archive (%lld volumes, %@ each). Saving splits it again using the same volume size."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivo comprimido dividido (%lld volúmenes de %@). Al guardar se dividirá de nuevo con el mismo tamaño de volumen."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaettu arkisto (%lld taltiota, %@ kukin). Tallennettaessa se jaetaan uudelleen samalla taltiokoolla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archive fractionnée (%lld volumes de %@). L’enregistrement la fractionnera à nouveau avec la même taille de volume."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "विभाजित आर्काइव (%lld वॉल्यूम, प्रत्येक %@)। सहेजने पर उसी वॉल्यूम आकार से फिर विभाजित होगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
