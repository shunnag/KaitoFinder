    "すべての巻を書き直して、同じ巻サイズで分割し直します。" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všechny svazky se přepíšou a znovu rozdělí se stejnou velikostí svazku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle enheder omskrives og opdeles igen med samme enhedsstørrelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Volumes werden neu geschrieben und mit derselben Volumegröße erneut aufgeteilt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All volumes will be rewritten and split again using the same volume size."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se reescribirán todos los volúmenes y se dividirán de nuevo con el mismo tamaño de volumen."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki taltiot kirjoitetaan uudelleen ja jaetaan samalla taltiokoolla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les volumes seront réécrits et fractionnés à nouveau avec la même taille de volume."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सभी वॉल्यूम दोबारा लिखे जाएँगे और उसी वॉल्यूम आकार में फिर से विभाजित किए जाएँगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua volume akan ditulis ulang dan dibagi lagi dengan ukuran volume yang sama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti i volumi verranno riscritti e suddivisi nuovamente con la stessa dimensione dei volumi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての巻を書き直して、同じ巻サイズで分割し直します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 볼륨을 다시 쓰고 동일한 볼륨 크기로 다시 분할합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua volum akan ditulis semula dan dibahagikan lagi menggunakan saiz volum yang sama."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle volumene skrives på nytt og deles igjen med samme volumstørrelse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle volumes worden herschreven en opnieuw gesplitst met dezelfde volumegrootte."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie woluminy zostaną zapisane ponownie i podzielone przy użyciu tego samego rozmiaru woluminu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
