    "巻サイズが揃っていない分割アーカイブは、設定で「保存時にまとめて書き込む」を選ぶと編集できます。" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcete-li upravovat rozdělené archivy s různě velkými svazky, vyberte v Nastavení „Najednou při ukládání“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg “Samlet ved arkivering” i Indstillinger for at redigere opdelte arkiver med forskellige enhedsstørrelser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Bearbeiten geteilter Archive mit unterschiedlichen Volumegrößen in den Einstellungen „Zusammen beim Sichern“ wählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To edit split archives with uneven volume sizes, choose “Together When Saving” in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para editar archivos comprimidos divididos con volúmenes de tamaños distintos, selecciona “Juntos al guardar” en Ajustes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
