            "value" : "Složku nelze přesunout do ní samé ani do některé z jejích podsložek: %@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En mappe kan ikke flyttes ind i sig selv eller en af sine undermapper: %@."
