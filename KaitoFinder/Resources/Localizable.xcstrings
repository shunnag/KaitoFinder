    "プレビュー・外部アプリで開く項目は読み取り専用の一時コピーです。変更は書庫に保存されません。": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビュー・外部アプリで開く項目は読み取り専用の一時コピーです。変更は書庫に保存されません。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Previews and items opened in other apps are read-only temporary copies. Changes are not saved to the archive."
          }
        }
      }
    },
