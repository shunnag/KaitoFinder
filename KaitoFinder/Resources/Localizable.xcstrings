          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การประสานงานไฟล์เพื่อเปลี่ยนแปลงหมดเวลาแล้ว ต้นฉบับไม่เปลี่ยนแปลง โปรดลองเปลี่ยนแปลงอีกครั้ง"
