          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penyimpanan yang terganggu di lokasi ini mungkin memerlukan pemulihan. App lain yang membaca semasa penyimpanan mungkin melihat campuran volum lama dan baharu."
