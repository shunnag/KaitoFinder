    "編集するとアーカイブ全体を再圧縮します" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editing will recompress the entire archive."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "編集するとアーカイブ全体を再圧縮します"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Bearbeiten wird das gesamte Archiv erneut komprimiert"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modification recompressera toute l’archive"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al editar, se volverá a comprimir todo el archivo comprimido"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modifica ricomprimerà l’intero archivio"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A edição recomprimirá todo o arquivo comprimido"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "编辑时将重新压缩整个归档"
