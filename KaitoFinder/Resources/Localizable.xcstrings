    "分割アーカイブの保存を完了できませんでした。回復するまで編集できません。アーカイブを開き直してください。" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukládání rozděleného archivu se nepodařilo dokončit. Úpravy jsou do obnovy vypnuté. Otevři archiv znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arkivering af det opdelte komprimerede arkiv kunne ikke fuldføres. Redigering er deaktiveret indtil gendannelse. Åbn arkivet igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
