          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delt arkiv (%lld volumer, %@ hver). Ved lagring deles det på nytt med samme volumstørrelse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
