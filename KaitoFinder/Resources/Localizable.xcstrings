    "変更のためのファイル調整が時間切れになりました。原本は変更されていません。もう一度変更してください。" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vypršel časový limit koordinace souborů pro změnu. Originál se nezměnil. Zkuste změnu znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidsgrænsen for filkoordinering af ændringen blev overskredet. Originalen er uændret. Prøv ændringen igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Dateikoordination für die Änderung hat das Zeitlimit überschritten. Das Original ist unverändert. Die Änderung erneut versuchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File coordination for the change timed out. The original is unchanged. Try the change again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se agotó el tiempo de coordinación de archivos para el cambio. El original no ha cambiado. Intenta el cambio de nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muutoksen tiedostokoordinointi aikakatkaistiin. Alkuperäinen on ennallaan. Yritä muutosta uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La coordination des fichiers pour la modification a expiré. L’original est inchangé. Réessayer la modification."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बदलाव के लिए फ़ाइल समन्वय का समय समाप्त हो गया। मूल फ़ाइल बदली नहीं गई है। बदलाव का फिर से प्रयास करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koordinasi file untuk perubahan kehabisan waktu. File asli tidak berubah. Coba perubahan lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il coordinamento dei file per la modifica è scaduto. L’originale è invariato. Riprova la modifica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変更のためのファイル調整が時間切れになりました。原本は変更されていません。もう一度変更してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "변경을 위한 파일 조정 시간이 초과되었습니다. 원본은 변경되지 않았습니다. 변경을 다시 시도해 주세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penyelarasan fail untuk perubahan telah tamat masa. Fail asal tidak berubah. Cuba perubahan semula."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidsgrensen for filkoordinering av endringen ble overskredet. Originalen er uendret. Prøv endringen på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De bestandscoördinatie voor de wijziging is verlopen. Het origineel is ongewijzigd. Probeer de wijziging opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upłynął limit czasu koordynacji plików do zmiany. Oryginał nie został zmieniony. Ponów zmianę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tempo de coordenação dos arquivos para a alteração esgotou. O original não foi alterado. Tente a alteração novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tempo de coordenação dos ficheiros para a alteração expirou. O original não foi alterado. Tente a alteração novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
