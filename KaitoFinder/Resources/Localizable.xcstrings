    "フォルダはプレビューまたは外部アプリケーションで開けません。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folders cannot be previewed or opened in another application."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォルダはプレビューまたは外部アプリケーションで開けません。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordner können nicht in der Vorschau oder in einem anderen Programm geöffnet werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dossiers ne peuvent pas être prévisualisés ni ouverts dans une autre application."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las carpetas no se pueden previsualizar ni abrir en otra aplicación."
