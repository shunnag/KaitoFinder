    "フォルダはプレビューまたは外部アプリケーションで開けません。" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Složky nelze zobrazit v náhledu ani otevřít v jiné aplikaci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapper kan ikke vises som eksempler eller åbnes i en anden app."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordner können nicht in der Vorschau oder in einem anderen Programm geöffnet werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folders cannot be previewed or opened in another application."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las carpetas no se pueden previsualizar ni abrir en otra aplicación."
