        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This encrypted item requires a password."
          }
        }
      }
    },
    "不完全な項目は内容を検証できないため開けません": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不完全な項目は内容を検証できないため開けません"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This incomplete item cannot be opened because its contents cannot be verified."
          }
        }
      }
    },
    "リンクまたは特殊な項目は単独で開けません": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクまたは特殊な項目は単独で開けません"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Links and special items cannot be opened individually."
          }
        }
      }
    },
