        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप इसकी सामग्री और जोड़े जा रहे आइटम से नया आर्काइव बना सकते हैं। मूल आर्काइव नहीं बदलेगा।"
