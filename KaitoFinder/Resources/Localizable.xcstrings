        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Ordner kann nicht in sich selbst oder einen seiner Unterordner bewegt werden: %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A folder cannot be moved into itself or one of its subfolders: %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede trasladar una carpeta a sí misma ni a una de sus subcarpetas: %@."
